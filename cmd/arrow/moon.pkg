import {
  "dongxuan2012/oscbridge" @comtrade,
  "dongxuan2012/oscbridge/arrow" @adapter,
  "moonbitlang/core/debug",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "export_arrow_ipc",
        "status_events",
        "export_transition_ipc",
      ],
      "format": "esm",
    },
  },
)
